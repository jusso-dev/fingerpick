<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets animations run at up to 120 Hz on ProMotion iPhones, including both iPhone Duo displays. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Launch screen: plain background matching the first frame (white in light mode, black in dark). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
