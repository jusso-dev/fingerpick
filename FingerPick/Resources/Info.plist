<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPad multitasking requires all four orientations. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Lets animations run at up to 120 Hz on ProMotion iPhones, including both iPhone Duo displays. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Live Activity for the last result (#29); off by default in Settings. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Launch screen: the winner's mark from the icon on a plain background (white in light mode,
	     black in dark). The splash (SplashView) starts on this exact frame and animates from it. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
</dict>
</plist>
